{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/jongablop/ekhi-utils/main/schemas/ekhi-schema.json",
  "title": "EKHI dataset schema",
  "type": "object",
  "properties": {
    "publication_info": {
      "type": "object",
      "properties": {
        "doi": { "type": "string" },
        "pages": { "type": "string" },
        "number": { "type": "string" },
        "volume": { "type": "string" },
        "year": { "type": "string" },
        "journal": { "type": "string" },
        "title": { "type": "string" },
        "author": { "type": "string" },
        "ENTRYTYPE": { "type": "string" },
        "ID": { "type": "string" },
        "abstract": { "type": "string" }
      },
      "required": ["doi", "title", "author", "ENTRYTYPE", "ID"]
    },
    "id": { "type": "string" },
    "material": { "type": "string" },
    "property": {
        "type": "array",
        "items": { "type": "string" }
    },
    "category": {
        "type": "array",
        "items": { "type": "string" }
    },
    "reported_measurements": {
        "type": "array",
        "items": {
          "$ref": "https://raw.githubusercontent.com/jongablop/fer/main/fer-schema.json"
        }
    }
  },
  "required": ["publication_info", "dataset_id", "material", "property", "reported_data"]
}
